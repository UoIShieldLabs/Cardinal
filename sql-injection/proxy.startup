#!/bin/bash
# proxy — bridges edge-net (eth0) and app-net (eth1); reverse-proxies to webapp.
ip addr add 172.30.0.10/24 dev eth0
ip addr add 172.31.0.10/24 dev eth1
ip link set eth0 up
ip link set eth1 up

# nginx.conf is mounted from proxy/etc/nginx/nginx.conf. Run in the foreground
# so Kathara keeps the container alive.
nginx -g 'daemon off;'
