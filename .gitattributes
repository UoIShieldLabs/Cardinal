# These files get COPY'd into Linux containers and executed directly (shebang),
# so CRLF line endings break them silently (Windows checkouts default to CRLF
# via core.autocrlf). Force LF regardless of the checking-out platform.
*.sh    text eol=lf
*.zeek  text eol=lf

# Not strictly required to run, but keep them consistent/diff-clean too.
Dockerfile  text eol=lf
*.rules     text eol=lf
*.conf      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
